        "queue_lag": 60,
        "queue_age_seconds": 10.0,
        "active_workers": 1
      }
    },
    {
      "id": "saturation_sustained",
      "expected_hypothesis": "worker_saturation",
      "expected_abstained": false,
      "rationale": "Two independent backlog measurements",
