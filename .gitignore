cat > .gitignore <<'EOF'
# Environment files and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node.js
node_modules/
dist/
coverage/
.vite/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
crash.log
crash.*.log

# Testing
playwright-report/
test-results/

# Runtime and generated files
.runtime/
.tmp/
.cache/

# IDE and operating system
.idea/
.vscode/
.DS_Store
Thumbs.db
EOF