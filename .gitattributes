# Enforce LF for maintained text; frozen evidence fixtures retain exact bytes.
# This overrides any developer's local core.autocrlf setting and ensures
# consistent line endings across Linux containers, macOS, and Windows.

* text=auto eol=lf

# Explicitly binary — never mangle.
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.woff binary
*.woff2 binary
*.gz   binary
*.zip  binary
*.tar  binary

# These frozen fixtures have recorded byte-level SHA256 hashes.
# Preserve their original bytes across Windows and Linux checkouts.
benchmarks/ai/capacity_held_out_v1/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
