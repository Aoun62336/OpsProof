{
  "uid": "opsproof-operations",
  "title": "OpsProof | Local Reliability Signals",
  "tags": [
    "opsproof",
    "local",
    "evidence"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Scrape target availability",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "opsproof-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"opsproof-demo-api|opsproof-control-api\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Demo jobs by state",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "opsproof-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "opsproof_demo_jobs",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "HTTP request rate by service",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "opsproof-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(opsproof_http_requests_total[2m]))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "HTTP latency p95, seconds",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "opsproof-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(opsproof_http_request_duration_seconds_bucket[2m])))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      }
    }
  ]
}
